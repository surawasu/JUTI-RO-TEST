*.a
*.lib
!/JUTI-HI Server/3rdparty/mysql/lib/**/*.lib
!/JUTI-HI Server/3rdparty/pcre/lib/**/*.lib
!/JUTI-HI Server/3rdparty/zlib/lib/**/*.lib
*.exp
*.dmp

